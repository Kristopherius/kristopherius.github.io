---
import { siteConfig } from "../config";

const games = siteConfig.games ?? [];
const hasGames = games.length > 0;
const accent = siteConfig.accentColor;

/* A game's aspect ratio decides how its player is laid out. A landscape build
   already fills the width, so its description reads underneath; a portrait
   build leaves room beside it, so the description sits to its right. */
function ratioOf(value: string | undefined): number {
  const [w, h] = String(value || "16 / 9")
    .split("/")
    .map((n) => parseFloat(n.trim()));
  if (!w || !h || !isFinite(w) || !isFinite(h)) return 16 / 9;
  return w / h;
}
---

{hasGames && (
  <section id="games" class="p-8 sm:p-12 md:p-16 lg:p-24">
    <div>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
        <div class="lg:col-span-4">
          <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
            Games
          </h2>
          <div
            class="w-[75px] h-[5px] mt-2 rounded-full"
            style={`background-color: ${accent}`}
          />
        </div>

        <div class="lg:col-span-8">
          <p class="text-lg sm:text-xl md:text-2xl leading-relaxed text-gray-600">
            Play some of my games right here — they run in your browser, no
            download and no install needed.
          </p>

          <div class="mt-8 space-y-8">
            {games.map((game, index) => {
              const modalId = `gm-${index}`;
              const playable = Boolean(game.embedPath);
              const ratio = ratioOf(game.aspectRatio);
              const portrait = ratio < 1;

              return (
                <div class="group relative p-4 sm:p-6 md:p-8 bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200">
                  {/* Cover. The game itself lives in the player dialog, so
                      nothing here loads a build until it is asked for. */}
                  <div
                    class="relative w-full overflow-hidden rounded-lg bg-gray-900"
                    style={`aspect-ratio: ${game.aspectRatio || "16 / 9"}`}
                  >
                    {playable ? (
                      <>
                        {game.thumbnail ? (
                          <img
                            src={game.thumbnail}
                            alt={`${game.name} cover art`}
                            class="absolute inset-0 w-full h-full object-cover"
                          />
                        ) : (
                          <div
                            class="absolute inset-0"
                            style={`background-image: linear-gradient(135deg, ${accent} 0%, #111827 70%)`}
                          />
                        )}
                        <div class="absolute inset-0 bg-black/40 flex flex-col items-center justify-center gap-4">
                          <button
                            type="button"
                            class="gm-open flex items-center gap-3 px-6 py-3 rounded-full text-white font-medium shadow-lg transition-transform duration-300 hover:scale-105 focus:outline-none focus-visible:ring-4 focus-visible:ring-white/60"
                            style={`background-color: ${accent}`}
                            data-modal={modalId}
                            aria-haspopup="dialog"
                            aria-label={`Play ${game.name} in your browser`}
                          >
                            <svg
                              class="w-5 h-5"
                              viewBox="0 0 24 24"
                              fill="currentColor"
                              aria-hidden="true"
                            >
                              <path d="M8 5v14l11-7z" />
                            </svg>
                            Play in browser
                          </button>
                          <p class="text-xs sm:text-sm text-white/80 font-medium">
                            Opens in a player
                          </p>
                        </div>
                      </>
                    ) : (
                      <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 border-2 border-dashed border-gray-600 rounded-lg text-center px-6">
                        <p class="text-base sm:text-lg font-bold text-white">
                          Coming soon
                        </p>
                        <p class="text-xs sm:text-sm text-gray-400 max-w-sm">
                          Placeholder entry — add the web build to
                          <span class="font-mono"> public/games/ </span>
                          and set <span class="font-mono">embedPath</span> in
                          <span class="font-mono"> src/config.ts</span>.
                        </p>
                      </div>
                    )}
                  </div>

                  <div class="space-y-4 mt-6">
                    <div>
                      <span class="text-sm font-mono" style={`color: ${accent}`}>
                        0{index + 1}
                      </span>
                      <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mt-1">
                        {game.name}
                      </h3>
                      {game.dateRange && (
                        <p class="text-sm text-gray-500 mt-1">{game.dateRange}</p>
                      )}
                    </div>

                    {game.description && (
                      <p class="text-base sm:text-lg text-gray-600 leading-relaxed">
                        {game.description}
                      </p>
                    )}

                    {game.skills && game.skills.length > 0 && (
                      <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-2">
                        {game.skills.map((skill) => (
                          <span class="px-2.5 sm:px-3 py-1 sm:py-1.5 bg-gray-900 text-white rounded-md sm:rounded-lg text-xs sm:text-sm font-medium">
                            {skill}
                          </span>
                        ))}
                      </div>
                    )}

                    {game.link && (
                      <div class="flex flex-wrap gap-3 pt-4">
                        <a
                          href={game.link}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="px-4 py-2 border-2 border-gray-900 text-gray-900 rounded-lg text-sm font-medium hover:bg-gray-900 hover:text-white transition-all duration-300"
                        >
                          More about this game
                        </a>
                      </div>
                    )}
                  </div>

                  {/* ---- the player dialog ---- */}
                  {playable && (
                    <div
                      id={modalId}
                      class={`gm-modal fixed inset-0 z-50 hidden ${portrait ? "gm-portrait" : "gm-landscape"}`}
                      style={`display:none; --ar-num:${ratio}; --ar-css:${game.aspectRatio || "16 / 9"}`}
                      data-src={game.embedPath}
                      data-title={game.name}
                      role="dialog"
                      aria-modal="true"
                      aria-label={`${game.name} player`}
                    >
                      <div class="gm-backdrop absolute inset-0 bg-black/70 backdrop-blur-sm" />

                      <div class="gm-scroll relative h-full w-full overflow-y-auto p-3 sm:p-5">
                        <div class="gm-panel mx-auto bg-white rounded-2xl shadow-2xl">
                          <div class="sticky top-0 z-10 flex items-start justify-between gap-4 px-5 py-4 bg-white border-b border-gray-200 rounded-t-2xl">
                            <div>
                              <h3 class="text-lg sm:text-xl font-bold text-gray-900">
                                {game.name}
                              </h3>
                              {game.dateRange && (
                                <p class="text-xs text-gray-500 mt-0.5">
                                  {game.dateRange}
                                </p>
                              )}
                            </div>
                            <button
                              type="button"
                              class="gm-close shrink-0 text-gray-400 hover:text-gray-600 transition-colors"
                              aria-label="Close player"
                            >
                              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                              </svg>
                            </button>
                          </div>

                          <div class="gm-body p-4 sm:p-5">
                            <div class="gm-frame relative overflow-hidden rounded-lg bg-gray-900">
                              {/* iframe is injected here on open */}
                            </div>

                            <div class="gm-info mt-4">
                              {/* A landscape build is cramped in a dialog and
                                  reads much better filling the screen, so the
                                  suggestion is made where it applies. */}
                              {!portrait && (
                                <div
                                  class="flex flex-wrap items-center gap-3 mb-4 p-3 rounded-lg"
                                  style={`background-color: ${accent}14`}
                                >
                                  <button
                                    type="button"
                                    class="gm-fullscreen px-4 py-2 rounded-lg text-sm font-medium text-white transition-transform duration-200 hover:scale-105"
                                    style={`background-color: ${accent}`}
                                  >
                                    Play fullscreen
                                  </button>
                                  <p class="text-sm text-gray-600">
                                    This one is best played fullscreen.
                                  </p>
                                </div>
                              )}

                              {game.description && (
                                <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
                                  {game.description}
                                </p>
                              )}

                              {game.controls && (
                                <p class="text-sm text-gray-500 mt-3">
                                  <span class="font-semibold text-gray-700">Controls: </span>
                                  {game.controls}
                                </p>
                              )}

                              {game.skills && game.skills.length > 0 && (
                                <div class="flex flex-wrap gap-1.5 sm:gap-2 mt-4">
                                  {game.skills.map((skill) => (
                                    <span class="px-2.5 py-1 bg-gray-900 text-white rounded-md text-xs font-medium">
                                      {skill}
                                    </span>
                                  ))}
                                </div>
                              )}

                              <div class="flex flex-wrap gap-3 mt-5">
                                {portrait && (
                                  <button
                                    type="button"
                                    class="gm-fullscreen px-4 py-2 bg-gray-900 text-white rounded-lg text-sm font-medium hover:bg-gray-700 transition-colors"
                                  >
                                    Fullscreen
                                  </button>
                                )}
                                <button
                                  type="button"
                                  class="gm-close px-4 py-2 border-2 border-gray-300 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-100 transition-colors"
                                >
                                  Close
                                </button>
                                {game.link && (
                                  <a
                                    href={game.link}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="px-4 py-2 border-2 border-gray-900 text-gray-900 rounded-lg text-sm font-medium hover:bg-gray-900 hover:text-white transition-all"
                                  >
                                    More about this game
                                  </a>
                                )}
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  /* The frame keeps the build's own aspect ratio and is capped against the
     viewport height, so the player never grows taller than the screen it has
     to fit inside. */
  .gm-frame {
    width: 100%;
    aspect-ratio: var(--ar-css);
    margin-inline: auto;
  }
  .gm-landscape .gm-frame { max-width: calc(56vh * var(--ar-num)); }
  .gm-portrait .gm-frame { max-width: calc(70vh * var(--ar-num)); }
  @supports (height: 100dvh) {
    /* dvh accounts for a phone's collapsing address bar; vh does not. */
    .gm-landscape .gm-frame { max-width: calc(56dvh * var(--ar-num)); }
    .gm-portrait .gm-frame { max-width: calc(70dvh * var(--ar-num)); }
  }

  .gm-panel { max-width: min(96vw, 1200px); }
  .gm-portrait .gm-panel { max-width: min(96vw, 1080px); }

  /* Portrait builds leave room beside them, so the description moves to the
     right of the frame once there is width for a second column. */
  @media (min-width: 900px) {
    .gm-portrait .gm-body {
      display: flex;
      align-items: flex-start;
      gap: 1.5rem;
    }
    .gm-portrait .gm-frame { flex: 0 0 auto; margin-inline: 0; }
    .gm-portrait .gm-info { flex: 1 1 0; min-width: 0; margin-top: 0; }
  }

  /* Inline sizing must not constrain the frame once it is the whole screen. */
  .gm-frame:fullscreen {
    max-width: none !important;
    width: 100%;
    height: 100%;
    aspect-ratio: auto !important;
    border-radius: 0;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    /* Only ever one live build. A WebGL game keeps its context, its audio and
       its render loop alive for as long as the iframe exists, so the iframe is
       created on open and destroyed on close rather than hidden — and opening
       a second game tears the first one down before it starts. */
    let openModal: HTMLElement | null = null;

    const teardown = (modal: HTMLElement | null) => {
      if (!modal) return;
      if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
      modal.querySelector(".gm-frame iframe")?.remove();
      modal.classList.add("hidden");
      modal.style.display = "none";
      if (openModal === modal) openModal = null;
    };

    const close = () => {
      teardown(openModal);
      document.body.style.overflow = "";
    };

    const open = (modal: HTMLElement, src: string, title: string) => {
      if (openModal && openModal !== modal) teardown(openModal);

      const frame = modal.querySelector<HTMLElement>(".gm-frame");
      if (!frame) return;
      frame.querySelector("iframe")?.remove();

      const iframe = document.createElement("iframe");
      iframe.src = src;
      iframe.title = title;
      iframe.className = "absolute inset-0 w-full h-full border-0";
      iframe.setAttribute("allow", "autoplay; fullscreen; gamepad; xr-spatial-tracking");
      iframe.setAttribute("allowfullscreen", "");
      frame.appendChild(iframe);

      modal.classList.remove("hidden");
      modal.style.display = "block";
      document.body.style.overflow = "hidden";
      openModal = modal;
      modal.querySelector<HTMLElement>(".gm-close")?.focus();
    };

    document.querySelectorAll<HTMLElement>(".gm-open").forEach((button) => {
      button.addEventListener("click", () => {
        const modal = document.getElementById(button.dataset.modal ?? "");
        const src = modal?.dataset.src;
        if (modal && src) open(modal, src, modal.dataset.title ?? "Browser game");
      });
    });

    document.querySelectorAll<HTMLElement>(".gm-close").forEach((button) => {
      button.addEventListener("click", close);
    });

    /* The scrolling container is layered over the backdrop and swallows its
       clicks, so dismissal is bound there instead — and only when the press
       landed on the container itself rather than bubbling out of the panel,
       or a click inside the game would close the player. */
    document.querySelectorAll<HTMLElement>(".gm-scroll").forEach((scroller) => {
      scroller.addEventListener("click", (event) => {
        if (event.target === scroller) close();
      });
    });

    document.querySelectorAll<HTMLElement>(".gm-fullscreen").forEach((button) => {
      button.addEventListener("click", () => {
        const frame = button.closest(".gm-modal")?.querySelector<HTMLElement>(".gm-frame");
        if (!frame) return;
        if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
        else frame.requestFullscreen?.().catch(() => {});
      });
    });

    /* Escape closes the player only while focus is still on the page. Once a
       game has focus the key belongs to it — Perihelion opens its pause menu
       on Escape, and Stress Experiment deliberately leaves it to the browser
       for releasing pointer lock — and the parent document never sees the
       event anyway. That is why the header is sticky: the X, the Close button
       and clicking outside the panel are the exits that always work. */
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && openModal && !document.fullscreenElement) close();
    });
  });
</script>
